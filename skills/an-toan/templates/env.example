# Sao chép file này thành ".env" rồi điền giá trị thật. KHÔNG commit file .env.
# Mỗi dự án dùng khóa RIÊNG, mỗi môi trường (dev / staging / production) dùng khóa RIÊNG.

APP_ENV=development

# Nhà cung cấp AI — tạo khóa riêng cho dự án này, bật trần chi tiêu cứng cho khóa
LLM_API_KEY=

# Database — tài khoản quyền hẹp, KHÔNG phải admin / service_role
DATABASE_URL=

# Giới hạn an toàn (L6, A8) — code phải đọc và thực thi các giá trị này
MAX_INPUT_CHARS=4000
MAX_OUTPUT_TOKENS=1024
USER_TOKENS_PER_DAY=50000
AGENT_MAX_STEPS=15
AGENT_MAX_COST_USD_PER_RUN=0.50
AGENT_KILL_SWITCH=off
